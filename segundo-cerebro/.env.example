# Copia este archivo como ".env" y rellena los datos de tu instancia de Neo4j Aura.
# Los encuentras en el archivo de credenciales que Aura te permite descargar al crear la instancia.
# (En ese archivo la variable del usuario se llama NEO4J_USERNAME; aquí también se acepta ese nombre.)
NEO4J_URI=neo4j+s://2efb29fa.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<la contraseña de ese mismo archivo>

# OpenAI es opcional; su API alojada cobra según el uso. No compartas este archivo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Alternativa: URL de un servidor local compatible con la API de OpenAI (por ejemplo LM Studio).
# Al usarlo, OPENAI_API_KEY puede quedar vacío si el servidor local no requiere clave.
OPENAI_BASE_URL=

# OpenAlex es un índice académico público; contacto opcional para sus solicitudes.
OPENALEX_MAILTO=

# Solicitudes de IA/verificación permitidas por minuto y por IP (por defecto 20).
LIMITE_IA_POR_MINUTO=20

# Mantener false fuera del desarrollo local.
FLASK_DEBUG=false
