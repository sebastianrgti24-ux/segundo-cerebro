# Copia este archivo como ".env" y rellena los datos.

# ---- Neo4j Aura (obligatorio) ----
# (En el archivo de credenciales de Aura el usuario se llama NEO4J_USERNAME; aquí también se acepta.)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=tu_contraseña_de_aura

# ---- IA (opcional) ----
# Sin OPENAI_API_KEY la app funciona igual en "modo sin IA" (reglas), sin costo.
# ATENCIÓN: la API de OpenAI es de pago (se cobra por uso). Revisa precios y pon un límite de gasto en tu cuenta.
# OPENAI_API_KEY=sk-...
# Verifica el nombre vigente del modelo en la documentación de tu proveedor.
# OPENAI_MODEL=gpt-4o-mini
# Alternativa gratuita/local compatible con OpenAI (p. ej. Ollama): 
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1
# OPENAI_TIMEOUT=30
# OPENAI_MAX_TOKENS=800

# ---- Límites y entorno (opcionales) ----
# LIMITE_IA_POR_MINUTO=12
# LIMITE_GENERAL_POR_MINUTO=120
# APP_ENTORNO=desarrollo   # usa "produccion" para desactivar el modo debug
